@model PagerModel
@if (Model.TotalPages > 1)
{
    string Link(int p) { var rv = new RouteValueDictionary(); foreach (var kv in Model.Query) if (!string.IsNullOrEmpty(kv.Value)) rv[kv.Key] = kv.Value; rv["page"] = p; return Url.Action(Model.Action, Model.Controller, rv)!; }
    var from = Math.Max(1, Model.Page - 3); var to = Math.Min(Model.TotalPages, Model.Page + 3);
    <nav class="pager" aria-label="Pages">
        @if (Model.Page > 1) { <a href="@Link(Model.Page - 1)">&laquo; Prev</a> }
        @for (var p = from; p <= to; p++) { if (p == Model.Page) { <span class="cur">@p</span> } else { <a href="@Link(p)">@p</a> } }
        @if (Model.Page < Model.TotalPages) { <a href="@Link(Model.Page + 1)">Next &raquo;</a> }
        <span>Page @Model.Page of @Model.TotalPages</span>
    </nav>
}
