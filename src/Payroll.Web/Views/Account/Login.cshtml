@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="card">
    <h1>Ledgerline</h1>
    <p class="muted">Sign in to the payroll console.</p>
    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div class="field"><label asp-for="Username">Username</label><input asp-for="Username" autocomplete="username" autofocus /></div>
        <div class="field" style="margin-top:.8rem"><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="current-password" /></div>
        <p><button class="btn" type="submit">Sign in</button></p>
    </form>
</div>
