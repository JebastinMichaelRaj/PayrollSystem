{
  "ConnectionStrings": {
    "PayrollDb": "Server=RRR_2013_1;Database=PayrollDb;Integrated Security=true;TrustServerCertificate=true;Encrypt=true"
  },
  "Payroll": {
    "FinancialYearStartMonth": 4,
    "WeekendDays": "Saturday,Sunday",
    "MaxOvertimeHoursPerMonth": 60,
    "LoanRecoveryCapPercentOfNet": 50,
    "RequireSeparateApprover": true,
    "LeaveBackdateLimitDays": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 12
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "PayrollAdmin@2026"
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.Hosting.Lifetime": "Information" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/payroll-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "AllowedHosts": "*"
}
