@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<div class="card" style="max-width:480px">
    <h1>Change password</h1>
    <p class="muted">At least 12 characters with upper-case, lower-case, a digit and a symbol.</p>
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div class="field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /></div>
        <div class="field" style="margin-top:.8rem"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /></div>
        <div class="field" style="margin-top:.8rem"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /></div>
        <p><button class="btn" type="submit">Update password</button></p>
    </form>
</div>
